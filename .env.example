# このファイルを `.env` としてコピーして使用してください (.env は git 管理外です)
#   cp .env.example .env

# --- ビルドバージョン ---
MC_VERSION=26.2
LOADER_VERSION=0.19.5
INSTALLER_VERSION=1.1.2

# --- Mojang EULA ---
# https://www.minecraft.net/eula に同意する場合のみ TRUE にしてください。
# FALSE のままではサーバーは起動しません。
EULA=FALSE

# --- 公開設定 ---
SERVER_PORT=25565
MOTD=A Fabric Minecraft Server
DIFFICULTY=normal
GAMEMODE=survival
MAX_PLAYERS=20
ONLINE_MODE=true
PVP=true
VIEW_DISTANCE=10
SIMULATION_DISTANCE=10
WHITELIST=false
LEVEL_SEED=

# --- RCON (リモート管理、既定では無効) ---
ENABLE_RCON=false
RCON_PASSWORD=change-me-to-a-strong-password
RCON_PORT=25575

# --- JVMメモリ (このホストは物理RAM 11GiB / 2 OCPU を想定したデフォルト) ---
MEMORY_MIN=2G
MEMORY_MAX=6G
JAVA_OPTS=
